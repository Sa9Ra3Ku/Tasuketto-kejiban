generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostType {
  WORRY
  ISSUE
  DEDUCTION
  HYPOTHESIS
  PREDICTION
}

enum DeepDiveType {
  EMPATHY
  PERSPECTIVE
  HYPOTHESIS
  DEDUCTION
  REBUTTAL
  SUMMARY
  EXPERIENCE
}

enum ReportTargetType {
  POST
  DEEPDIVE
}

enum ReportReasonKey {
  ATTACK
  HARASSMENT
  SPAM
  SEXUAL
  ILLEGAL
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

model User {
  id                       String    @id @default(cuid())
  name                     String
  email                    String    @unique
  emailVerified            DateTime?
  image                    String?
  hashedPassword           String?
  stripeCustomerId         String?   @unique
  stripeSubscriptionId     String?   @unique
  subscriptionStatus       String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionPlanKey      String?
  /// /me の「自分へ返ってきた重なり」をどこまで追ったか（null は未設定＝一覧はすべて「新しく返ってきた」扱い）
  incomingOverlapsSeenAt   DateTime?
  createdAt                DateTime  @default(now())
  posts                    Post[]
  deepDives                DeepDive[]
  savedPosts               SavedPost[]
  reports                  Report[]
  accounts                 Account[]
  sessions                 Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id           Int        @id @default(autoincrement())
  title        String
  body         String
  type         PostType
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isHidden     Boolean    @default(false)
  hiddenReason String?
  hiddenAt     DateTime?
  deepDives    DeepDive[]
  postTags     PostTag[]
  savedBy      SavedPost[]
  reports      Report[]
}

model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    String
  postId    Int
  createdAt DateTime @default(now())
  /// この流れを手元でどこまで見たか（null は保存時点を基準に扱う）
  lastSeenAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model DeepDive {
  id               Int          @id @default(autoincrement())
  postId           Int
  userId           String
  parentDeepDiveId Int?
  type             DeepDiveType
  body             String
  createdAt        DateTime     @default(now())
  isHidden         Boolean      @default(false)
  hiddenReason     String?
  hiddenAt         DateTime?
  post             Post         @relation(fields: [postId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
  parentDeepDive   DeepDive?    @relation("DeepDiveReference", fields: [parentDeepDiveId], references: [id])
  childDeepDives   DeepDive[]   @relation("DeepDiveReference")
  reports          Report[]
}

model Report {
  id               Int              @id @default(autoincrement())
  reporterUserId   String
  targetType       ReportTargetType
  targetPostId     Int?
  targetDeepDiveId Int?
  reasonKey        ReportReasonKey
  note             String?
  status           ReportStatus     @default(OPEN)
  createdAt        DateTime         @default(now())
  reporter         User             @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetPost       Post?            @relation(fields: [targetPostId], references: [id], onDelete: Cascade)
  targetDeepDive   DeepDive?        @relation(fields: [targetDeepDiveId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetPostId, targetDeepDiveId])
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  postTags PostTag[]
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}
